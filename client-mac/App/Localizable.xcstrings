    "Connected computers can see this screen but can’t use its keyboard and mouse until Accessibility is allowed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected computers can see this screen but can’t use its keyboard and mouse until Accessibility is allowed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundene Computer können diesen Bildschirm sehen, aber Tastatur und Maus erst verwenden, wenn die Bedienungshilfen erlaubt sind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中のコンピューターはこの画面を見られますが、アクセシビリティが許可されるまでキーボードとマウスは使えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接的电脑可以查看此屏幕，但在允许辅助功能之前无法使用其键盘和鼠标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線的電腦可以檢視此螢幕，但在允許輔助使用之前無法使用其鍵盤和滑鼠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 컴퓨터는 이 화면을 볼 수 있지만, 손쉬운 사용이 허용되기 전에는 키보드와 마우스를 사용할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los equipos conectados pueden ver esta pantalla, pero no usar su teclado ni su ratón hasta que se permita Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ordinateurs connectés peuvent voir cet écran, mais pas utiliser son clavier ni sa souris tant que l’accessibilité n’est pas autorisée."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected computers can see this screen but can’t use its keyboard and mouse until Accessibility is allowed."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected computers can see this screen but can’t use its keyboard and mouse until Accessibility is allowed."
          }
        }
      }

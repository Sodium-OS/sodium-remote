    "Nobody can connect to this computer. Paired devices stay paired.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody can connect to this computer. Paired devices stay paired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand kann sich mit diesem Computer verbinden. Gekoppelte Geräte bleiben gekoppelt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピューターには誰も接続できません。ペアリング済みのデバイスはそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都无法连接到这台电脑。已配对的设备保持配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都無法連線到這台電腦。已配對的裝置會保持配對。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무도 이 컴퓨터에 연결할 수 없습니다. 페어링된 기기는 그대로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie puede conectarse a este equipo. Los dispositivos vinculados siguen vinculados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne peut se connecter à cet ordinateur. Les appareils associés restent associés."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody can connect to this computer. Paired devices stay paired."

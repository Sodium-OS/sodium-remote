    "Without the local network, Sodium Remote can’t find computers at home by itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the local network, Sodium Remote can’t find computers at home by itself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the local network, Sodium Remote can’t find computers at home by itself."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the local network, Sodium Remote can’t find computers at home by itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有本地网络权限，Sodium Remote 无法自行找到家中的电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有區域網路權限，Sodium Remote 無法自行找到家中的電腦。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークを使えないと、Sodium Remote は自宅のコンピューターを自力で見つけられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크를 사용할 수 없으면 Sodium Remote가 집에 있는 컴퓨터를 직접 찾을 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin la red local, Sodium Remote no puede encontrar por sí solo los equipos de casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans le réseau local, Sodium Remote ne peut pas trouver seul les ordinateurs à la maison."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne das lokale Netzwerk kann Sodium Remote Computer zu Hause nicht selbst finden."
          }
        }
      }
    },
    "You connected from %@ at %@, so this Mac was disconnected. Only one device streams at a time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You connected from %@ at %@, so this Mac was disconnected. Only one device streams at a time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You connected from %@ at %@, so this Mac was disconnected. Only one device streams at a time."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You connected from %@ at %@, so this Mac was disconnected. Only one device streams at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已从 %1$@ 于 %2$@ 连接，因此这台 Mac 已断开。同一时间只有一台设备可以串流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已從 %1$@ 於 %2$@ 連線，因此這台 Mac 已中斷連線。同一時間只有一台裝置可以串流。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ から %2$@ に接続したため、この Mac は切断されました。同時にストリーミングできるデバイスは 1 台だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에 %1$@에서 연결했으므로 이 Mac의 연결이 끊어졌습니다. 한 번에 한 기기만 스트리밍할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te conectaste desde %1$@ a las %2$@, así que este Mac se ha desconectado. Solo un dispositivo puede transmitir a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous êtes connecté depuis %1$@ à %2$@, ce Mac a donc été déconnecté. Un seul appareil peut diffuser à la fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben sich von %1$@ um %2$@ verbunden, daher wurde dieser Mac getrennt. Es kann immer nur ein Gerät streamen."
          }
        }
      }
    },
    "Your SodiumOS computer on this Mac. Two permissions make it feel local; you can change them later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your SodiumOS computer on this Mac. Two permissions make it feel local; you can change them later in Settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your SodiumOS computer on this Mac. Two permissions make it feel local; you can change them later in Settings."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your SodiumOS computer on this Mac. Two permissions make it feel local; you can change them later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上使用您的 SodiumOS 电脑。两项权限让它用起来像本机；您之后可以在“设置”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 Mac 上使用您的 SodiumOS 電腦。兩項權限讓它用起來像本機；您之後可以在「設定」中變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で使う、あなたの SodiumOS コンピューター。2 つの許可で手元のように使えます。あとから「設定」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 사용하는 SodiumOS 컴퓨터입니다. 두 가지 권한으로 로컬처럼 사용할 수 있으며, 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu equipo SodiumOS en este Mac. Dos permisos hacen que parezca local; puedes cambiarlos más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur SodiumOS sur ce Mac. Deux autorisations lui donnent un air de local ; vous pourrez les modifier plus tard dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr SodiumOS-Computer auf diesem Mac. Zwei Berechtigungen lassen ihn wie lokal wirken; Sie können sie später in den Einstellungen ändern."
          }
        }
      }
    },

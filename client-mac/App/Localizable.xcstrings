    "Typing your password at the desk always ends the remote session and unlocks there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing your password at the desk always ends the remote session and unlocks there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing your password at the desk always ends the remote session and unlocks there."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing your password at the desk always ends the remote session and unlocks there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑旁输入密码，始终会结束远程会话并在该电脑上解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在電腦旁輸入密碼，一律會結束遠端工作階段並在該電腦上解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューター本体でパスワードを入力すると、必ずリモートセッションが終了し、そのコンピューターでロックが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 직접 비밀번호를 입력하면 항상 원격 세션이 종료되고 그곳에서 잠금이 해제됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al escribir la contraseña en el equipo, siempre se termina la sesión remota y se desbloquea allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisir le mot de passe sur l’ordinateur met toujours fin à la session à distance et déverrouille celui-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabe des Passworts am Computer beendet immer die Fernsitzung und entsperrt dort."
          }
        }
      }
    },
    "UDP is blocked on this network, so Sodium Remote goes through the relay over TCP.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP is blocked on this network, so Sodium Remote goes through the relay over TCP."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP is blocked on this network, so Sodium Remote goes through the relay over TCP."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP is blocked on this network, so Sodium Remote goes through the relay over TCP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网络已屏蔽 UDP，因此 Sodium Remote 会通过 TCP 经中继传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此網路已封鎖 UDP，因此 Sodium Remote 會透過 TCP 經中繼傳輸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワークでは UDP がブロックされているため、Sodium Remote は TCP でリレー経由の接続を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크에서는 UDP가 차단되어 Sodium Remote가 TCP를 통해 릴레이로 연결합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP está bloqueado en esta red, así que Sodium Remote usa el relé a través de TCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP est bloqué sur ce réseau ; Sodium Remote passe donc par le relais via TCP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP ist in diesem Netzwerk gesperrt, daher nutzt Sodium Remote das Relay über TCP."
          }
        }
      }
    },

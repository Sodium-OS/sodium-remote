    "That code didn’t match. Check the computer and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn’t match. Check the computer and try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn’t match. Check the computer and try again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn’t match. Check the computer and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码不匹配。请检查电脑后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼不符。請檢查電腦後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが一致しませんでした。コンピューターを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 일치하지 않습니다. 컴퓨터를 확인한 뒤 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código no coincide. Comprueba el equipo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne correspond pas. Vérifiez l’ordinateur, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code stimmt nicht überein. Prüfen Sie den Computer und versuchen Sie es erneut."
          }
        }
      }
    },
    "That code didn’t match. Check the computer and try again. Tries left: %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn’t match. Check the computer and try again. Tries left: %lld."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn’t match. Check the computer and try again. Tries left: %lld."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn’t match. Check the computer and try again. Tries left: %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码不匹配。请检查电脑后重试。剩余尝试次数：%lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼不符。請檢查電腦後再試一次。剩餘嘗試次數：%lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが一致しませんでした。コンピューターを確認して、もう一度お試しください。残り試行回数：%lld 回。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 일치하지 않습니다. 컴퓨터를 확인한 뒤 다시 시도하세요. 남은 시도 횟수: %lld회."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código no coincide. Comprueba el equipo y vuelve a intentarlo. Intentos restantes: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne correspond pas. Vérifiez l’ordinateur, puis réessayez. Essais restants : %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code stimmt nicht überein. Prüfen Sie den Computer und versuchen Sie es erneut. Verbleibende Versuche: %lld."
          }
        }
      }
    },

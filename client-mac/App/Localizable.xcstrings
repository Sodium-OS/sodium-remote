    "Sodium Remote only connects to a server over an encrypted connection. Use an address that starts with https:// or wss://, or just the server’s name.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote only connects to a server over an encrypted connection. Use an address that starts with https:// or wss://, or just the server’s name."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote only connects to a server over an encrypted connection. Use an address that starts with https:// or wss://, or just the server’s name."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote only connects to a server over an encrypted connection. Use an address that starts with https:// or wss://, or just the server’s name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 只通过加密连接来连接服务器。请使用以 https:// 或 wss:// 开头的地址，或只输入服务器名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 只會透過加密連線來連線到伺服器。請使用以 https:// 或 wss:// 開頭的位址，或只輸入伺服器名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote は暗号化された接続でのみサーバーに接続します。https:// または wss:// で始まるアドレス、またはサーバー名だけを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote는 암호화된 연결로만 서버에 연결합니다. https:// 또는 wss://로 시작하는 주소를 쓰거나 서버 이름만 입력하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote solo se conecta a un servidor mediante una conexión cifrada. Usa una dirección que empiece por https:// o wss://, o solo el nombre del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote ne se connecte à un serveur que par une connexion chiffrée. Utilisez une adresse commençant par https:// ou wss://, ou seulement le nom du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote verbindet sich nur verschlüsselt mit einem Server. Verwenden Sie eine Adresse, die mit https:// oder wss:// beginnt, oder nur den Namen des Servers."
          }
        }
      }
    },
    "That file doesn’t hold a certificate. Choose the certificate authority’s PEM file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file doesn’t hold a certificate. Choose the certificate authority’s PEM file."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "That file doesn’t hold a certificate. Choose the certificate authority’s PEM file."
          }
        },
        "en-AU": {

    "This server needs an enrollment token. Enter the one you were given.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server needs an enrollment token. Enter the one you were given."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This server needs an enrolment token. Enter the one you were given."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This server needs an enrolment token. Enter the one you were given."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器需要注册令牌。请输入你收到的令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

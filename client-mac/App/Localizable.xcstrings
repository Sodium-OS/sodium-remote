    "This Mac stops trusting its key and can’t connect until you pair again. %@ still lists this Mac until you remove it there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac stops trusting its key and can’t connect until you pair again. %@ still lists this Mac until you remove it there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac stops trusting its key and can’t connect until you pair again. %@ still lists this Mac until you remove it there."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac stops trusting its key and can’t connect until you pair again. %@ still lists this Mac until you remove it there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 将不再信任其密钥，重新配对前无法连接。在 %@ 上移除之前，它仍会列出这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 將不再信任其金鑰，重新配對前無法連線。在 %@ 上移除之前，它仍會列出這台 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac はそのキーを信頼しなくなり、再度ペアリングするまで接続できません。%@ には、そちらで削除するまでこの Mac が残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 해당 키를 더 이상 신뢰하지 않으며, 다시 페어링할 때까지 연결할 수 없습니다. %@에서 직접 제거하기 전까지는 그쪽 목록에 이 Mac이 남아 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac dejará de confiar en su clave y no podrá conectarse hasta que vuelvas a vincularlo. %@ seguirá mostrando este Mac hasta que lo elimines allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac cesse de faire confiance à sa clé et ne peut plus se connecter tant que vous ne l’avez pas associé à nouveau. %@ continue de lister ce Mac tant que vous ne l’y supprimez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac vertraut seinem Schlüssel nicht mehr und kann sich erst nach erneuter Kopplung wieder verbinden. %@ führt diesen Mac weiterhin auf, bis Sie ihn dort entfernen."
          }
        }
      }
    },

    "Choose **Pair a device**. It shows a 6-digit code for 5 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Pair a device**. It shows a 6-digit code for 5 minutes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Pair a device**. It shows a 6-digit code for 5 minutes."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Pair a device**. It shows a 6-digit code for 5 minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“**配对设备**”。它会显示一个 6 位数字的代码，5 分钟内有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「**配對裝置**」。它會顯示一組 6 位數的代碼，5 分鐘內有效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「**デバイスをペアリング**」を選びます。6 桁のコードが 5 分間表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘**기기 페어링**’을 선택합니다. 6자리 코드가 5분 동안 표시됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «**Vincular un dispositivo**». Muestra un código de 6 dígitos durante 5 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « **Associer un appareil** ». Un code à 6 chiffres s’affiche pendant 5 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie „**Gerät koppeln**“. Es zeigt 5 Minuten lang einen 6-stelligen Code an."
          }
        }
      }
    },

    "Asleep since %@. Remote keeps trying while this window is open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asleep since %@. Remote keeps trying while this window is open."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Asleep since %@. Remote keeps trying while this window is open."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Asleep since %@. Remote keeps trying while this window is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自 %@ 起处于睡眠状态。此窗口打开期间，Remote 会持续尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自 %@ 起處於睡眠狀態。此視窗開啟期間，Remote 會持續嘗試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からスリープ中です。このウインドウを開いている間、Remote は再試行を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@부터 절전 중입니다. 이 윈도우가 열려 있는 동안 Remote가 계속 시도합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En reposo desde %@. Remote sigue intentándolo mientras esta ventana esté abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En veille depuis %@. Remote continue d’essayer tant que cette fenêtre est ouverte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit %@ im Ruhezustand. Remote versucht es weiter, solange dieses Fenster geöffnet ist."
          }
        }
      }
    },

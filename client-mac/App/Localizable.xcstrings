        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码在电脑上的“设置 › 远程控制 › 配对设备”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼在電腦上的「設定 › 遠端控制 › 配對裝置」中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードはコンピューターの「設定 › リモート › デバイスをペアリング」にあります。"
          }
        },
        "ko": {

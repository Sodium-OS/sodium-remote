    "Decided: text sharp when still, motion smooth when moving; quality drops before frame rate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decided: text sharp when still, motion smooth when moving; quality drops before frame rate."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Decided: text sharp when still, motion smooth when moving; quality drops before frame rate."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Decided: text sharp when still, motion smooth when moving; quality drops before frame rate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "策略：静止时文字清晰，运动时画面流畅；先降低画质，再降低帧率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "策略：靜止時文字清晰，移動時動態流暢；先降低畫質，再降低幀率。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方針：静止時は文字をくっきり、動きがあるときはなめらかに。フレームレートより先に画質を下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방침: 정지 시에는 글자를 선명하게, 움직일 때는 부드럽게 유지하며 프레임 속도보다 화질을 먼저 낮춥니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidido: texto nítido en reposo, movimiento fluido al moverse; la calidad baja antes que la tasa de fotogramas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décidé : texte net à l’arrêt, mouvement fluide en déplacement ; la qualité baisse avant la fréquence d’images."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festgelegt: Text scharf im Stillstand, Bewegung flüssig bei Bewegung; die Qualität sinkt vor der Bildrate."
          }
        }
      }
    },

          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur demande un jeton d’inscription. Saisissez celui qu’on vous a donné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verlangt ein Registrierungstoken. Geben Sie das Token ein, das Sie erhalten haben."
          }
        }
      }
    },
    "That enrollment token isn’t valid. Check it with the person who runs the server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That enrollment token isn’t valid. Check it with the person who runs the server."
          }
        },
        "en-GB": {

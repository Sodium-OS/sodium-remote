    "Sodium Remote can’t find %@ on this network. Check the Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote can’t find %@ on this network. Check the Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote findet %@ in diesem Netzwerk nicht. WLAN prüfen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote はこのネットワーク上で %@ を見つけられません。Wi-Fi を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 无法在本网络中找到 %@。请检查 Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 無法在此網路上找到 %@。請檢查 Wi-Fi。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote가 이 네트워크에서 %@을(를) 찾지 못했습니다. Wi-Fi를 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote no puede encontrar %@ en esta red. Comprueba la Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote ne trouve pas %@ sur ce réseau. Vérifiez le Wi-Fi."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote can’t find %@ on this network. Check the Wi-Fi."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote can’t find %@ on this network. Check the Wi-Fi."
          }
        }
      }
    },
    "Sodium Remote can’t reach %@ or find %@ on this network. Check the Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote can’t reach %@ or find %@ on this network. Check the Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote erreicht %@ nicht und findet %@ in diesem Netzwerk nicht. WLAN prüfen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote は %@ に接続できず、このネットワーク上で %@ も見つけられません。Wi-Fi を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 无法连接到 %@，也无法在本网络中找到 %@。请检查 Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 無法連線到 %@，也無法在此網路上找到 %@。請檢查 Wi-Fi。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote가 %@에 연결하지 못하고 이 네트워크에서 %@도 찾지 못했습니다. Wi-Fi를 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote no puede conectar con %@ ni encontrar %@ en esta red. Comprueba la Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote ne peut pas joindre %@ ni trouver %@ sur ce réseau. Vérifiez le Wi-Fi."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote can’t reach %@ or find %@ on this network. Check the Wi-Fi."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote can’t reach %@ or find %@ on this network. Check the Wi-Fi."
          }
        }
      }
    },
    "Sodium Remote doesn’t check for updates and doesn’t send usage data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote doesn’t check for updates and doesn’t send usage data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote sucht nicht nach Updates und sendet keine Nutzungsdaten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote は更新を確認せず、利用データも送信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 不会检查更新，也不会发送使用数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote 不會檢查更新，也不會傳送使用資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote는 업데이트를 확인하지 않으며 사용 데이터를 전송하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote no busca actualizaciones ni envía datos de uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote ne recherche pas de mises à jour et n’envoie aucune donnée d’utilisation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote doesn’t check for updates and doesn’t send usage data."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote doesn’t check for updates and doesn’t send usage data."
          }
        }
      }
    },
    "Sodium Remote doesn’t contact any server until you add one. A server helps computers on different networks find each other, and relays the picture when they can’t connect directly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote doesn’t contact any server until you add one. A server helps computers on different networks find each other, and relays the picture when they can’t connect directly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote kontaktiert keinen Server, bevor Sie einen hinzufügen. Ein Server hilft Computern in verschiedenen Netzwerken, sich zu finden, und leitet das Bild weiter, wenn keine direkte Verbindung möglich ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを追加するまで、Sodium Remote はどのサーバーにも接続しません。サーバーは、別々のネットワークにあるコンピューター同士が見つけ合うのを助け、直接接続できないときは映像を中継します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您添加服务器之前，Sodium Remote 不会连接任何服务器。服务器可帮助位于不同网络的电脑互相找到对方，并在无法直接连接时中继画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您新增伺服器之前，Sodium Remote 不會連線到任何伺服器。伺服器可協助位於不同網路的電腦互相找到對方，並在無法直接連線時轉送畫面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버를 추가하기 전에는 Sodium Remote가 어떤 서버에도 연결하지 않습니다. 서버는 서로 다른 네트워크에 있는 컴퓨터가 서로를 찾도록 돕고, 직접 연결할 수 없을 때 화면을 중계합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote no se conecta a ningún servidor hasta que añades uno. Un servidor ayuda a que los equipos de redes distintas se encuentren y retransmite la imagen cuando no pueden conectarse directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote ne contacte aucun serveur tant que vous n’en ajoutez pas un. Un serveur aide les ordinateurs de réseaux différents à se trouver et relaie l’image lorsqu’ils ne peuvent pas se connecter directement."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote doesn’t contact any server until you add one. A server helps computers on different networks find each other, and relays the picture when they can’t connect directly."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote doesn’t contact any server until you add one. A server helps computers on different networks find each other, and relays the picture when they can’t connect directly."
          }
        }
      }
    },

        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a atteint sa limite pour le moment. Les ordinateurs de ce réseau et par adresse fonctionnent toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat vorerst sein Limit erreicht. Computer in diesem Netzwerk und per Adresse funktionieren weiterhin."
          }
        }
      }
    },

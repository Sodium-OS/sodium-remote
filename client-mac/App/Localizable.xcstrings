    "It can’t connect to this computer again until you pair it again. If it’s connected now, it’s disconnected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can’t connect to this computer again until you pair it again. If it’s connected now, it’s disconnected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann sich erst nach erneuter Kopplung wieder verbinden. Falls es gerade verbunden ist, wird die Verbindung getrennt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度ペアリングするまで、このコンピューターには接続できなくなります。現在接続中の場合は切断されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新配对之前，它将无法再连接到这台电脑。如果它当前已连接，连接将被断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新配對之前，它將無法再連線到這台電腦。如果它目前已連線，連線將被中斷。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 페어링하기 전에는 이 컴퓨터에 연결할 수 없습니다. 지금 연결되어 있다면 연결이 끊어집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrá volver a conectarse a este equipo hasta que lo vincules de nuevo. Si está conectado ahora, se desconectará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne pourra plus se connecter à cet ordinateur tant que vous ne l’aurez pas associé à nouveau. S’il est connecté, il sera déconnecté."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It can’t connect to this computer again until you pair it again. If it’s connected now, it’s disconnected."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "It can’t connect to this computer again until you pair it again. If it’s connected now, it’s disconnected."
          }
        }
      }
    },
    "Its lock screen can’t be shown or controlled from here. The session resumes when the desktop is back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its lock screen can’t be shown or controlled from here. The session resumes when the desktop is back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sperrbildschirm lässt sich von hier nicht anzeigen oder steuern. Die Sitzung wird fortgesetzt, sobald der Desktop zurück ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面はここから表示も操作もできません。デスクトップに戻るとセッションが再開されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从这里显示或控制其锁定屏幕。桌面恢复后，会话将自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從這裡顯示或控制其鎖定螢幕。桌面恢復後，工作階段會自動繼續。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면은 여기에서 표시하거나 제어할 수 없습니다. 데스크톱이 돌아오면 세션이 다시 시작됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su pantalla de bloqueo no se puede mostrar ni controlar desde aquí. La sesión se reanuda cuando vuelva el escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son écran verrouillé ne peut pas être affiché ni contrôlé d’ici. La session reprend quand le bureau revient."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Its lock screen can’t be shown or controlled from here. The session resumes when the desktop is back."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Its lock screen can’t be shown or controlled from here. The session resumes when the desktop is back."
          }
        }
      }
    },
    "Its lock, sign-in or UAC screen can’t be shown or controlled from here. The session resumes when the desktop is back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its lock, sign-in or UAC screen can’t be shown or controlled from here. The session resumes when the desktop is back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperr-, Anmelde- oder UAC-Bildschirm lassen sich von hier nicht anzeigen oder steuern. Die Sitzung wird fortgesetzt, sobald der Desktop zurück ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面、サインイン画面、UAC 画面はここから表示も操作もできません。デスクトップに戻るとセッションが再開されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从这里显示或控制其锁定、登录或 UAC 屏幕。桌面恢复后，会话将自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從這裡顯示或控制其鎖定、登入或 UAC 螢幕。桌面恢復後，工作階段會自動繼續。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금, 로그인 또는 UAC 화면은 여기에서 표시하거나 제어할 수 없습니다. 데스크톱이 돌아오면 세션이 다시 시작됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su pantalla de bloqueo, de inicio de sesión o de UAC no se puede mostrar ni controlar desde aquí. La sesión se reanuda cuando vuelva el escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son écran de verrouillage, de connexion ou UAC ne peut pas être affiché ni contrôlé d’ici. La session reprend quand le bureau revient."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Its lock, sign-in or UAC screen can’t be shown or controlled from here. The session resumes when the desktop is back."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Its lock, sign-in or UAC screen can’t be shown or controlled from here. The session resumes when the desktop is back."
          }
        }
      }
    },

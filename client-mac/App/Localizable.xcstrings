    "Last seen %@. It may be turned off or without internet. Remote keeps trying while this window is open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last seen %@. It may be turned off or without internet. Remote keeps trying while this window is open."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Last seen %@. It may be turned off or without internet. Remote keeps trying while this window is open."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Last seen %@. It may be turned off or without internet. Remote keeps trying while this window is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次在线时间：%@。它可能已关机或没有网络。此窗口打开期间，Remote 会持续尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次上線時間：%@。它可能已關機或沒有網路。此視窗開啟期間，Remote 會持續嘗試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に確認: %@。電源が切れているか、インターネットに接続されていない可能性があります。このウインドウを開いている間、Remote は再試行を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 확인: %@. 전원이 꺼져 있거나 인터넷에 연결되어 있지 않을 수 있습니다. 이 윈도우가 열려 있는 동안 Remote가 계속 시도합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto por última vez: %@. Puede estar apagado o sin internet. Remote sigue intentándolo mientras esta ventana esté abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière activité : %@. Il est peut-être éteint ou sans internet. Remote continue d’essayer tant que cette fenêtre est ouverte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt gesehen: %@. Möglicherweise ist er ausgeschaltet oder ohne Internet. Remote versucht es weiter, solange dieses Fenster geöffnet ist."
          }
        }
      }
    },

    "%@ speaks Sodium Remote protocol %lld, which this Mac’s Sodium Remote (protocol %lld) can’t talk to. Install the new version on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speaks Sodium Remote protocol %lld, which this Mac’s Sodium Remote (protocol %lld) can’t talk to. Install the new version on this Mac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speaks Sodium Remote protocol %lld, which this Mac’s Sodium Remote (protocol %lld) can’t talk to. Install the new version on this Mac."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speaks Sodium Remote protocol %lld, which this Mac’s Sodium Remote (protocol %lld) can’t talk to. Install the new version on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用 Sodium Remote 协议 %lld，这台 Mac 上的 Sodium Remote（协议 %lld）无法与其通信。请在这台 Mac 上安装新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用 Sodium Remote 協定 %lld，這台 Mac 上的 Sodium Remote（協定 %lld）無法與其通訊。請在這台 Mac 上安裝新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は Sodium Remote のプロトコル %lld を使っており、この Mac の Sodium Remote（プロトコル %lld）とは通信できません。この Mac に新しいバージョンをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) Sodium Remote 프로토콜 %lld을(를) 사용하며, 이 Mac의 Sodium Remote(프로토콜 %lld)와 통신할 수 없습니다. 이 Mac에 새 버전을 설치하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa el protocolo %lld de Sodium Remote, con el que el Sodium Remote de este Mac (protocolo %lld) no puede comunicarse. Instala la nueva versión en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise le protocole %lld de Sodium Remote, avec lequel le Sodium Remote de ce Mac (protocole %lld) ne peut pas communiquer. Installez la nouvelle version sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet das Sodium-Remote-Protokoll %lld, mit dem das Sodium Remote dieses Mac (Protokoll %lld) nicht kommunizieren kann. Installieren Sie die neue Version auf diesem Mac."
          }
        }
      }
    },

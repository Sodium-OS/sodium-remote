    "%@ no longer lists this Mac, so it won’t answer. Pair again with a new code from the computer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no longer lists this Mac, so it won’t answer. Pair again with a new code from the computer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no longer lists this Mac, so it won’t answer. Pair again with a new code from the computer."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no longer lists this Mac, so it won’t answer. Pair again with a new code from the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的列表中已不再包含这台 Mac，因此不会应答。请使用该电脑上的新代码重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的清單中已不再包含這台 Mac，因此不會回應。請使用該電腦上的新代碼重新配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の一覧にこの Mac がなくなったため、応答しません。コンピューターに表示される新しいコードで、もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 목록에 더 이상 이 Mac이 없으므로 응답하지 않습니다. 컴퓨터에서 새 코드를 받아 다시 페어링하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya no incluye este Mac en su lista, así que no responderá. Vuelve a vincular con un código nuevo del equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répertorie plus ce Mac et ne répondra donc pas. Associez-le de nouveau avec un nouveau code affiché sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ führt diesen Mac nicht mehr auf und antwortet daher nicht. Mit einem neuen Code vom Computer erneut koppeln."
          }
        }
      }
    },

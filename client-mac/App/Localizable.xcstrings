        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone typed the password at %@, which ends the remote session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在 %@ 上输入了密码，这会结束远程会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在 %@ 上輸入了密碼，這會結束遠端工作階段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で誰かがパスワードを入力したため、リモートセッションが終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 %@에서 비밀번호를 입력하여 원격 세션이 종료되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien ha escrito la contraseña en %@, lo que termina la sesión remota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un a saisi le mot de passe sur %@, ce qui met fin à la session à distance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat am Computer %@ das Passwort eingegeben, wodurch die Fernsitzung endet."
          }
        }
      }
    },

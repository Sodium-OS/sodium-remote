    "Too many wrong codes, so the computer withdrew it. Make a new code there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong codes, so the computer withdrew it. Make a new code there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong codes, so the computer withdrew it. Make a new code there."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong codes, so the computer withdrew it. Make a new code there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误代码次数过多，电脑已使该代码失效。请在电脑上生成新代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯誤代碼次數過多，電腦已使該代碼失效。請在電腦上產生新代碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違ったコードが多すぎたため、コンピューター側でこのコードは無効になりました。そちらで新しいコードを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 코드가 너무 많아 컴퓨터가 이 코드를 폐기했습니다. 컴퓨터에서 새 코드를 만드세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se introdujeron demasiados códigos erróneos y el equipo retiró este. Genera un código nuevo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de codes erronés : l’ordinateur a annulé celui-ci. Créez-en un nouveau sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele falsche Codes, daher hat der Computer ihn zurückgezogen. Erzeugen Sie dort einen neuen Code."
          }
        }
      }
    },

    "Keep the computer’s size when this window resizes; the picture scales": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the computer’s size when this window resizes; the picture scales"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the computer’s size when this window resizes; the picture scales"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the computer’s size when this window resizes; the picture scales"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整此窗口大小时保持电脑的尺寸不变，画面随之缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整此視窗大小時保持電腦的尺寸不變，畫面會隨之縮放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィンドウのサイズを変えてもコンピューターのサイズは保たれ、映像が拡大縮小されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창의 크기를 바꿔도 컴퓨터의 크기는 유지되고 화면이 확대/축소됩니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el tamaño del equipo al cambiar el tamaño de esta ventana; la imagen se escala"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve la taille de l’ordinateur quand cette fenêtre est redimensionnée ; l’image est mise à l’échelle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die Größe des Computers bei, wenn sich dieses Fenster ändert; das Bild wird skaliert"
          }
        }
      }
    },

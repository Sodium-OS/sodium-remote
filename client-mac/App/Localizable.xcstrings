    "Under 15 Mb/s the computer swaps live blur for a cached one and pauses grain; above 25 Mb/s it comes back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 15 Mb/s the computer swaps live blur for a cached one and pauses grain; above 25 Mb/s it comes back"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 15 Mb/s the computer swaps live blur for a cached one and pauses grain; above 25 Mb/s it comes back"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 15 Mb/s the computer swaps live blur for a cached one and pauses grain; above 25 Mb/s it comes back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于 15 Mb/s 时，电脑会用缓存的模糊效果替代实时模糊并暂停颗粒效果；高于 25 Mb/s 时恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於 15 Mb/s 時，電腦會以快取的模糊效果取代即時模糊並暫停顆粒效果；高於 25 Mb/s 時恢復"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15 Mb/s 未満では、コンピューターはリアルタイムのぼかしをキャッシュ済みのぼかしに切り替え、粒状感を停止します。25 Mb/s を超えると元に戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15 Mb/s 미만에서는 컴퓨터가 실시간 블러를 캐시된 블러로 바꾸고 그레인을 일시 중지하며, 25 Mb/s를 넘으면 다시 돌아옵니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de 15 Mb/s, el equipo cambia el desenfoque en vivo por uno en caché y pausa el grano; por encima de 25 Mb/s vuelven"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous 15 Mb/s, l’ordinateur remplace le flou en direct par un flou en cache et suspend le grain ; au-dessus de 25 Mb/s, ils reviennent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter 15 Mb/s ersetzt der Computer den Live-Weichzeichner durch einen zwischengespeicherten und pausiert das Filmkorn; über 25 Mb/s kehren sie zurück"
          }
        }
      }
    },

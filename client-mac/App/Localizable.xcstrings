    "%@. Always through the relay applies from the next connection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Always through the relay applies from the next connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. „Immer über das Relay“ gilt ab der nächsten Verbindung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。「常にリレー経由」は次の接続から有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。“始终通过中继”将从下次连接起生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。「一律透過中繼」將從下次連線起生效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. ‘항상 릴레이 경유’는 다음 연결부터 적용됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. «Siempre a través del relé» se aplica desde la próxima conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. « Toujours via le relais » s’applique à partir de la prochaine connexion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Always through the relay applies from the next connection."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Always through the relay applies from the next connection."
          }
        }
      }
    },
    "A code works once, for 5 minutes, and three wrong tries withdraw it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A code works once, for 5 minutes, and three wrong tries withdraw it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Code gilt einmal, 5 Minuten lang; nach drei Fehlversuchen wird er zurückgezogen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードは 1 回限り、5 分間有効です。3 回間違えると無効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码只能使用一次，有效期 5 分钟；输错三次将作废。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼只能使用一次，有效期限 5 分鐘；輸入錯誤三次即作廢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 한 번만, 5분 동안 사용할 수 있으며 세 번 틀리면 취소됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código sirve una sola vez, durante 5 minutos, y tres intentos erróneos lo anulan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code ne sert qu’une fois, pendant 5 minutes, et trois essais erronés l’annulent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A code works once, for 5 minutes, and three wrong tries withdraw it."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A code works once, for 5 minutes, and three wrong tries withdraw it."
          }
        }
      }
    },

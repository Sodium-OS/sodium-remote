    "AirDrop and Handoff are on. On Wi-Fi they can hold packets back for up to 90 ms while streaming.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop and Handoff are on. On Wi-Fi they can hold packets back for up to 90 ms while streaming."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop and Handoff are on. On Wi-Fi they can hold packets back for up to 90 ms while streaming."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop and Handoff are on. On Wi-Fi they can hold packets back for up to 90 ms while streaming."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop 和 Handoff 已开启。在 Wi-Fi 下，串流时它们可能使数据包最多延迟 90 ms。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop 和 Handoff 已開啟。在 Wi-Fi 下，串流時它們可能使封包最多延遲 90 ms。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop と Handoff がオンです。Wi-Fi では、ストリーミング中にパケットが最大 90 ms 遅延することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop과 Handoff가 켜져 있습니다. Wi-Fi에서는 스트리밍 중에 패킷이 최대 90 ms까지 지연될 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop y Handoff están activados. En Wi-Fi pueden retener paquetes hasta 90 ms durante la transmisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop et Handoff sont activés. Sur Wi-Fi, ils peuvent retarder les paquets jusqu’à 90 ms pendant le streaming."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop und Handoff sind eingeschaltet. Im WLAN können sie während des Streamings Pakete bis zu 90 ms zurückhalten."
          }
        }
      }
    },

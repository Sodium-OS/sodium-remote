          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote はこのサーバーに対してのみ、この証明書を信頼します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium Remote는 이 서버에 대해서만 이 인증서를 신뢰합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

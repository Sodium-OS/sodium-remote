    "Someone typed three wrong codes, so pairing closed. Nobody can pair until you open it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone typed three wrong codes, so pairing closed. Nobody can pair until you open it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat dreimal einen falschen Code eingegeben, deshalb wurde die Kopplung beendet. Niemand kann koppeln, bis Sie sie wieder öffnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違ったコードが 3 回入力されたため、ペアリングを終了しました。もう一度開くまで、どのデバイスもペアリングできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人输错了 3 次代码，所以配对已关闭。在你重新打开之前，任何设备都无法配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人輸錯了 3 次代碼，所以配對已關閉。在你重新開啟之前，任何裝置都無法配對。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 코드를 세 번 잘못 입력하여 페어링이 닫혔습니다. 다시 열 때까지 어떤 기기도 페어링할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien ha escrito tres códigos incorrectos, así que la vinculación se ha cerrado. Nadie puede vincular hasta que la vuelvas a abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un a saisi trois codes erronés, l’association a donc été fermée. Personne ne peut s’associer tant que vous ne l’ouvrez pas à nouveau."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone typed three wrong codes, so pairing closed. Nobody can pair until you open it again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone typed three wrong codes, so pairing closed. Nobody can pair until you open it again."
          }
        }
      }
    },

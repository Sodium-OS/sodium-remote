    "%@ is unreachable. Automatic uses the other paths.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unreachable. Automatic uses the other paths."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. „Automatisch“ verwendet die anderen Pfade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続できません。「自動」では他の経路を使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法连接。“自动”会使用其他路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法連線。「自動」會使用其他路徑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결할 수 없습니다. ‘자동’은 다른 경로를 사용합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está accesible. «Automático» usa las demás rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est injoignable. « Automatique » utilise les autres chemins."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unreachable. Automatic uses the other paths."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unreachable. Automatic uses the other paths."
          }
        }
      }
    },

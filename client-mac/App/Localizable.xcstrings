    "The computer answering as %@ isn’t the one this Mac paired with. If it was reinstalled, forget it here, then pair it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer answering as %@ isn’t the one this Mac paired with. If it was reinstalled, forget it here, then pair it again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer answering as %@ isn’t the one this Mac paired with. If it was reinstalled, forget it here, then pair it again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer answering as %@ isn’t the one this Mac paired with. If it was reinstalled, forget it here, then pair it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 名义应答的电脑并不是这台 Mac 配对过的那台。如果它已重新安装，请在此处忘记它，然后重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 名義回應的電腦並不是這台 Mac 配對過的那台。如果它已重新安裝，請在此處忘記它，然後重新配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ として応答しているコンピューターは、この Mac がペアリングしたものではありません。再インストールした場合は、ここで削除してから、もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 응답하는 컴퓨터가 이 Mac과 페어링한 컴퓨터가 아닙니다. 다시 설치한 경우에는 여기서 삭제한 다음 다시 페어링하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo que responde como %@ no es el que este Mac vinculó. Si se reinstaló, olvídalo aquí y vuelve a vincularlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur qui répond sous le nom %@ n’est pas celui auquel ce Mac s’est associé. S’il a été réinstallé, oubliez-le ici, puis associez-le de nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer, der sich als %@ meldet, ist nicht der, mit dem dieser Mac gekoppelt wurde. Wurde er neu installiert, ihn hier vergessen und dann erneut koppeln."
          }
        }
      }
    },
    "The computer closed its pairing window. Make a new code there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer closed its pairing window. Make a new code there."
          }

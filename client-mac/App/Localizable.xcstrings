    "Found over the local network (mDNS). Pairing still needs the code, so a stranger on the same Wi-Fi gets nowhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found over the local network (mDNS). Pairing still needs the code, so a stranger on the same Wi-Fi gets nowhere."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Found over the local network (mDNS). Pairing still needs the code, so a stranger on the same Wi-Fi gets nowhere."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Found over the local network (mDNS). Pairing still needs the code, so a stranger on the same Wi-Fi gets nowhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过本地网络（mDNS）发现。配对仍需要代码，因此同一 Wi-Fi 上的陌生人无法配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過區域網路（mDNS）找到。配對仍需要代碼，因此同一個 Wi-Fi 上的陌生人無法配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク（mDNS）で見つかりました。ペアリングにはコードが必要なので、同じ Wi-Fi にいる第三者はペアリングできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크(mDNS)에서 찾았습니다. 페어링에는 여전히 코드가 필요하므로 같은 Wi-Fi에 있는 낯선 사람은 페어링할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado en la red local (mDNS). Para vincular sigue haciendo falta el código, así que un desconocido en el mismo Wi-Fi no puede hacer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvé sur le réseau local (mDNS). L’association exige toujours le code : un inconnu sur le même Wi-Fi n’ira nulle part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über das lokale Netzwerk (mDNS) gefunden. Zum Koppeln ist weiterhin der Code nötig, daher kommt eine fremde Person im selben WLAN nicht weiter."
          }
        }
      }
    },

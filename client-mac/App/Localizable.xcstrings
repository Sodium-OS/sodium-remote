    "%@’s 2-minute hold ended, so it put the desk back. Reconnect starts a new session.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s 2-minute hold ended, so it put the desk back. Reconnect starts a new session."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s 2-minute hold ended, so it put the desk back. Reconnect starts a new session."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s 2-minute hold ended, so it put the desk back. Reconnect starts a new session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 2 分钟保留时间已结束，因此它已恢复桌面。重新连接将开始新的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 2 分鐘保留時間已結束，因此它已還原桌面。重新連線將開始新的工作階段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の 2 分間の保留が終了したため、デスクトップを元に戻しました。再接続すると新しいセッションが始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 2분 대기 시간이 끝나 데스크톱을 원래대로 되돌렸습니다. 다시 연결하면 새 세션이 시작됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha terminado la retención de 2 minutos de %@, así que ha restaurado el escritorio. Al reconectar se inicia una sesión nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en attente de 2 minutes de %@ est terminée ; l’ordinateur a donc rétabli le bureau. Se reconnecter démarre une nouvelle session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 2-Minuten-Haltezeit von %@ ist abgelaufen, daher wurde der Desktop wiederhergestellt. Mit „Erneut verbinden“ beginnt eine neue Sitzung."
          }
        }
      }
    },

    "%@ is streaming %@ right now. Taking over ends that stream; nothing on the computer closes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is streaming %@ right now. Taking over ends that stream; nothing on the computer closes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is streaming %@ right now. Taking over ends that stream; nothing on the computer closes."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is streaming %@ right now. Taking over ends that stream; nothing on the computer closes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在串流 %2$@。接管会结束该串流，电脑上不会关闭任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在串流 %2$@。接管會結束該串流，電腦上不會關閉任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ をストリーミング中です。引き継ぐとそのストリームは終了しますが、コンピューター側では何も閉じられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 현재 %2$@을(를) 스트리밍 중입니다. 인계하면 해당 스트림이 종료되지만, 컴퓨터에서는 아무것도 닫히지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está transmitiendo %2$@ ahora mismo. Al tomar el control se termina esa transmisión; no se cierra nada en el equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ diffuse actuellement %2$@. Reprendre la main met fin à ce flux ; rien ne se ferme sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ streamt gerade %2$@. Beim Übernehmen endet dieser Stream; auf dem Computer wird nichts geschlossen."
          }
        }
      }
    },

    "Paste works too. It checks by itself at the sixth digit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste works too. It checks by itself at the sixth digit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste works too. It checks by itself at the sixth digit."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste works too. It checks by itself at the sixth digit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以粘贴。输入到第 6 位时会自动检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以貼上。輸入到第 6 位時會自動檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けも使えます。6 桁目で自動的に確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣기도 가능합니다. 여섯 번째 숫자에서 자동으로 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se puede pegar. Se comprueba solo al llegar al sexto dígito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collage fonctionne aussi. La vérification se fait toute seule au sixième chiffre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen funktioniert ebenfalls. Bei der sechsten Ziffer wird automatisch geprüft."
          }
        }

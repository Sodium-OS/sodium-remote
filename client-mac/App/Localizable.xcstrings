    "Shows a picture of each computer in the list. The pictures stay on this computer, and turning this off deletes them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a picture of each computer in the list. The pictures stay on this computer, and turning this off deletes them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt in der Liste ein Bild jedes Computers. Die Bilder bleiben auf diesem Computer; beim Ausschalten werden sie gelöscht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに各コンピューターの画像を表示します。画像はこのコンピューターにだけ保存され、オフにすると削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中显示每台电脑的画面。画面只保存在这台电脑上，关闭此选项会将其删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中顯示每台電腦的畫面。畫面只儲存在這台電腦上，關閉此選項會將其刪除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 각 컴퓨터의 화면을 표시합니다. 화면은 이 컴퓨터에만 저장되며, 끄면 삭제됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una imagen de cada equipo en la lista. Las imágenes se quedan en este equipo y, si lo desactivas, se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une image de chaque ordinateur dans la liste. Les images restent sur cet ordinateur et sont supprimées si vous désactivez cette option."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a picture of each computer in the list. The pictures stay on this computer, and turning this off deletes them."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a picture of each computer in the list. The pictures stay on this computer, and turning this off deletes them."
          }
        }
      }
    },

          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只添加你信任的服务器。它能看到哪些电脑在何时连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

    "“In use remotely”; the desk’s keyboard and mouse do nothing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“In use remotely”; the desk’s keyboard and mouse do nothing"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "“In use remotely”; the desk’s keyboard and mouse do nothing"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "“In use remotely”; the desk’s keyboard and mouse do nothing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示“远程使用中”；电脑旁的键盘和鼠标无效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示「遠端使用中」；電腦旁的鍵盤和滑鼠沒有作用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「リモートで使用中」と表示され、コンピューター本体のキーボードとマウスは反応しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘원격으로 사용 중’이 표시되며 컴퓨터 옆 키보드와 마우스는 동작하지 않습니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra «En uso remoto»; el teclado y el ratón del equipo no hacen nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche « Utilisé à distance » ; le clavier et la souris de l’ordinateur ne font rien"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt „Aus der Ferne in Benutzung“; Tastatur und Maus am Computer reagieren nicht"
          }
        }
      }
    },

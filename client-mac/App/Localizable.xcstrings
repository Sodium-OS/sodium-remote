    "Pair this Mac with a SodiumOS computer to stream it here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this Mac with a SodiumOS computer to stream it here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this Mac with a SodiumOS computer to stream it here."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this Mac with a SodiumOS computer to stream it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这台 Mac 与 SodiumOS 电脑配对，即可在此串流其画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這台 Mac 與 SodiumOS 電腦配對，即可在此串流其畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac を SodiumOS コンピューターとペアリングすると、ここにその画面を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac을 SodiumOS 컴퓨터와 페어링하면 여기에서 그 화면을 볼 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula este Mac con un equipo SodiumOS para verlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez ce Mac à un ordinateur SodiumOS pour l’afficher ici."

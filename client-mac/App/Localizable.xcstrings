    "This link carries its own certificate. Sodium Remote will trust it for this server only, so continue only if you trust whoever sent the link.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link carries its own certificate. Sodium Remote will trust it for this server only, so continue only if you trust whoever sent the link."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This link carries its own certificate. Sodium Remote will trust it for this server only, so continue only if you trust whoever sent the link."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This link carries its own certificate. Sodium Remote will trust it for this server only, so continue only if you trust whoever sent the link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此链接自带证书。Sodium Remote 只会对这台服务器信任该证书，因此请仅在你信任链接发送者时继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連結自帶憑證。Sodium Remote 只會對這台伺服器信任該憑證，因此請僅在你信任連結傳送者時繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクには独自の証明書が含まれています。Sodium Remote はこのサーバーに対してのみその証明書を信頼します。リンクの送信者を信頼できる場合のみ続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크에는 자체 인증서가 들어 있습니다. Sodium Remote는 이 서버에 대해서만 해당 인증서를 신뢰합니다. 링크를 보낸 사람을 신뢰하는 경우에만 계속하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace incluye su propio certificado. Sodium Remote confiará en él solo para este servidor, así que continúa únicamente si confías en quien te envió el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien contient son propre certificat. Sodium Remote ne lui fera confiance que pour ce serveur ; ne continuez que si vous faites confiance à l’expéditeur du lien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link bringt ein eigenes Zertifikat mit. Sodium Remote vertraut ihm nur für diesen Server. Fahren Sie nur fort, wenn Sie dem Absender des Links vertrauen."
          }
        }
      }
    },
    "Sodium Remote will trust this certificate for this server only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {

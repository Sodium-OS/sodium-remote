@@ -1593,6 +1639,41 @@ VOID SudoVDAIoDeviceControl(
 
 		break;
 	}
+	case IOCTL_UPDATE_VIRTUAL_DISPLAY_MODE: {
+		if (InputBufferLength < sizeof(VIRTUAL_DISPLAY_UPDATE_MODE_PARAMS)) {
+			Status = STATUS_BUFFER_TOO_SMALL;
+			break;
+		}
+
+		PVIRTUAL_DISPLAY_UPDATE_MODE_PARAMS params;
+		Status = WdfRequestRetrieveInputBuffer(Request, sizeof(VIRTUAL_DISPLAY_UPDATE_MODE_PARAMS), (PVOID*)&params, NULL);
+		if (!NT_SUCCESS(Status)) {
+			break;
+		}
+
+		if (!params->Width || !params->Height || !params->RefreshRate) {
+			Status = STATUS_INVALID_PARAMETER;
+			break;
+		}
+
+		Status = STATUS_NOT_FOUND;
+
+		std::lock_guard<std::mutex> lg(monitorListOp);
+
+		for (auto* ctx : monitorCtxList) {
+			if (ctx->monitorGuid == params->MonitorGuid) {
+				VirtualMonitorMode mode = {params->Width, params->Height, params->RefreshRate};
+				if (mode.VSync < 1000) {
+					mode.VSync *= 1000;
+				}
+				ctx->preferredMode = mode;
+				Status = UpdateTargetModes(ctx->GetMonitor());
+				break;
+			}
+		}
+
+		break;
+	}
 	case IOCTL_SET_RENDER_ADAPTER: {
 		PVIRTUAL_DISPLAY_SET_RENDER_ADAPTER_PARAMS params;
 		Status = WdfRequestRetrieveInputBuffer(Request, sizeof(VIRTUAL_DISPLAY_SET_RENDER_ADAPTER_PARAMS), (PVOID*)&params, NULL);

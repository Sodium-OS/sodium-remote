+// Rebuilds the monitor's target modes from its preferred mode and hands them to IddCx, so a new size
+// becomes available without the monitor leaving and the desktop topology changing.
+static NTSTATUS UpdateTargetModes(IDDCX_MONITOR Monitor)
+{
+	NTSTATUS Status;
+	IDARG_OUT_QUERYTARGETMODES Count{};
+
+	if (isHDRSupported) {
+		IDARG_IN_QUERYTARGETMODES2 Query{};
+		Status = SudoVDAMonitorQueryModes2(Monitor, &Query, &Count);
+		if (!NT_SUCCESS(Status)) {
+			return Status;
+		}
+		vector<IDDCX_TARGET_MODE2> Modes(Count.TargetModeBufferOutputCount);
+		Query.TargetModeBufferInputCount = (UINT)Modes.size();
+		Query.pTargetModes = Modes.data();
+		Status = SudoVDAMonitorQueryModes2(Monitor, &Query, &Count);
+		if (!NT_SUCCESS(Status)) {
+			return Status;
+		}
+		IDARG_IN_UPDATEMODES2 Update{};
+		Update.Reason = IDDCX_UPDATE_REASON_OTHER;
+		Update.TargetModeCount = (UINT)Modes.size();
+		Update.pTargetModes = Modes.data();
+		return IddCxMonitorUpdateModes2(Monitor, &Update);
+	}
+
+	IDARG_IN_QUERYTARGETMODES Query{};
+	Status = SudoVDAMonitorQueryModes(Monitor, &Query, &Count);
+	if (!NT_SUCCESS(Status)) {
+		return Status;
+	}
+	vector<IDDCX_TARGET_MODE> Modes(Count.TargetModeBufferOutputCount);
+	Query.TargetModeBufferInputCount = (UINT)Modes.size();
+	Query.pTargetModes = Modes.data();
+	Status = SudoVDAMonitorQueryModes(Monitor, &Query, &Count);
+	if (!NT_SUCCESS(Status)) {
+		return Status;
+	}
+	IDARG_IN_UPDATEMODES Update{};
+	Update.Reason = IDDCX_UPDATE_REASON_OTHER;
+	Update.TargetModeCount = (UINT)Modes.size();
+	Update.pTargetModes = Modes.data();
+	return IddCxMonitorUpdateModes(Monitor, &Update);
+}

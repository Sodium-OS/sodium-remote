# Settings for sodium-remote-server.service, which reads this file as /etc/sodium-remote-server/server.env.
# One line, systemd-style (no shell): the server's options, see `sodium-remote-server --help`.
#   --server-name   the DNS name devices use; it is bound into their signatures, so every device must use the same name
#   --listen        address and port (default 0.0.0.0:8443)
#   --turn-url      the STUN and TURN addresses handed out with relay credentials (coturn, see docs/self-hosting.md); repeat
#   --enrol         token (default: new hosts need `sodium-remote-server token new`), open, or allowlist (with --hosts-allow FILE)
# Edit the name, then: systemctl enable --now sodium-remote-server
SODIUM_REMOTE_SERVER_ARGS="--server-name relay.example.com --listen 0.0.0.0:8443 --turn-url stun:relay.example.com:3478 --turn-url turn:relay.example.com:3478?transport=udp --turn-url turns:relay.example.com:5349?transport=tcp --enrol token"

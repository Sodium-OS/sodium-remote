# D-Bus activation for org.sodiumos.Remote: opening Settings › Remote starts remoted
# through its systemd user unit (sodiumos-remoted.service). The Arch package
# sodium-remote-sodiumos installs it as /usr/share/dbus-1/services/org.sodiumos.Remote.service.
[D-BUS Service]
Name=org.sodiumos.Remote
Exec=/usr/bin/false
SystemdService=sodiumos-remoted.service

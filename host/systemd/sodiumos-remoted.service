# remoted, Remote's host daemon on SodiumOS, as a systemd user service in the graphical
# session. The Arch package sodium-remote-sodiumos installs it as
# /usr/lib/systemd/user/sodiumos-remoted.service, with remoted in /usr/bin and the D-Bus
# activation file (../dbus/org.sodiumos.Remote.service). Installing starts and enables
# nothing: Settings › Remote starts it through the activation file when it opens, and
# `systemctl --user enable --now sodiumos-remoted` runs it from sign-in.
# To run a remoted built in a checkout instead, override ExecStart in a drop-in
# (`systemctl --user edit sodiumos-remoted`): an empty `ExecStart=`, then
# `ExecStart=/path/to/sodium-remote/target/release/remoted run`.
#
# - It reads HYPRLAND_INSTANCE_SIGNATURE and WAYLAND_DISPLAY from the user manager
#   (Hyprland imports both at start), and owns org.sodiumos.Remote on the session
#   bus, which Settings › Remote and the shell's privacy pill use.
# - Crash policy (Settings › Remote, SR8 "remoted stopped 3 times in a minute, so
#   it's paused"): restarted after 2 s; a third failure within 60 s leaves it
#   stopped until "Start Remote".
# - On stop (SIGTERM) it ends the session first: windows back, REMOTE-1 removed,
#   the default sink back. TimeoutStopSec leaves time for that. If it is killed
#   anyway, the next start puts the desktop and the audio defaults back from its
#   runtime files.
[Unit]
Description=Remote host daemon (remoted)
Documentation=https://github.com/sodium-os/sodium-remote/blob/main/docs/hosts/sodiumos.md
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
Requisite=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.sodiumos.Remote
ExecStart=/usr/bin/remoted run
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
Slice=app-graphical.slice
NoNewPrivileges=yes
LockPersonality=yes

[Install]
WantedBy=graphical-session.target

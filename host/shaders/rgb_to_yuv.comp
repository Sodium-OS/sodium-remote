#version 450
// XRGB8888 (sRGB-encoded) -> NV12 or planar YUV 4:4:4, BT.709 full range.
//
// "sRGB-correct": the matrix is applied to the sRGB-encoded R'G'B' values, as
// BT.709 defines Y'CbCr. The source is sampled through a UNORM view (never an
// _SRGB one), so the hardware does not linearise it first. The stream's VUI says
// BT.709 primaries and matrix, sRGB transfer, full range, so the client inverts
// exactly this.
//
// One invocation converts a 4x2 pixel block and writes whole 32-bit words.
// Planes share one buffer and one pitch (a multiple of 4 >= width):
//   NV12:   Y at 0, interleaved CbCr at off_u (height/2 rows)
//   YUV444: Y at 0, Cb at off_u, Cr at off_v
//
// Change detection (milestone 1): with cell != 0, every word written is compared
// with the same word of the previous frame's output (prev), and flags[cell index]
// is set where anything differs, per encoder cell (cell x cell pixels, cols per
// row). A 4x2 block never straddles a cell (cell is a multiple of 4), so each
// invocation touches one flag. Apps often damage more than they change; this is
// what really changed.

layout(local_size_x = 16, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, std430) writeonly buffer Out { uint words[]; };
layout(set = 0, binding = 2, std430) readonly buffer Prev { uint prev[]; };
layout(set = 0, binding = 3, std430) buffer Flags { uint flags[]; };

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint pitch;
    uint off_u;
    uint off_v;
    uint mode; // 0 NV12, 1 YUV444
    uint cell; // 0: no change detection
    uint cols;
} pc;

vec3 rgb_to_yuv(vec3 c)
{
    float y = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return vec3(y, (c.b - y) / 1.8556 + 0.5, (c.r - y) / 1.5748 + 0.5);
}

uint pack4(vec4 v)
{
    uvec4 b = uvec4(clamp(round(v * 255.0), 0.0, 255.0));
    return b.x | (b.y << 8) | (b.z << 16) | (b.w << 24);
}

bool changed = false;

void put(uint index, uint w)
{
    if (pc.cell != 0 && prev[index] != w)
        changed = true;
    words[index] = w;
}

void main()
{
    uint x0 = gl_GlobalInvocationID.x * 4;
    uint y0 = gl_GlobalInvocationID.y * 2;
    if (x0 >= pc.width || y0 >= pc.height)
        return;

    vec3 p[2][4];
    ivec2 last = ivec2(pc.width - 1, pc.height - 1);
    for (int j = 0; j < 2; j++)
        for (int i = 0; i < 4; i++)
            p[j][i] = rgb_to_yuv(texelFetch(src, min(ivec2(x0 + i, y0 + j), last), 0).rgb);

    for (int j = 0; j < 2; j++) {
        uint row = y0 + j;
        if (row >= pc.height)
            break;
        uint at = row * pc.pitch + x0;
        put(at / 4, pack4(vec4(p[j][0].x, p[j][1].x, p[j][2].x, p[j][3].x)));
        if (pc.mode == 1) {
            put((pc.off_u + at) / 4, pack4(vec4(p[j][0].y, p[j][1].y, p[j][2].y, p[j][3].y)));
            put((pc.off_v + at) / 4, pack4(vec4(p[j][0].z, p[j][1].z, p[j][2].z, p[j][3].z)));
        }
    }
    if (pc.mode == 0) {
        // 2x2 box filter: chroma sits at the centre of each 2x2 luma block.
        vec2 c0 = (p[0][0].yz + p[0][1].yz + p[1][0].yz + p[1][1].yz) * 0.25;
        vec2 c1 = (p[0][2].yz + p[0][3].yz + p[1][2].yz + p[1][3].yz) * 0.25;
        put((pc.off_u + (y0 / 2) * pc.pitch + x0) / 4, pack4(vec4(c0, c1)));
    }
    if (changed)
        flags[(y0 / pc.cell) * pc.cols + x0 / pc.cell] = 1u;
}
